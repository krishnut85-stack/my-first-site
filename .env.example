# SectorBot environment template — copy to a private .env on the DROPLET only.
# NEVER commit a real .env. NEVER put Kite/TOTP secrets in GitHub.
# (.env is already gitignored.)

# --- Kite (for REAL prices on the droplet) ---------------------------------
# Reuse your main bot's key + the token file it refreshes daily via TOTP.
KITE_API_KEY=your_kite_api_key
KITE_TOKEN_FILE=/home/globalbot/data/kite_token.json
# Alternatively, a raw token (expires daily) instead of the file:
# KITE_ACCESS_TOKEN=

# --- Email (optional) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=krishnut85@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=krishnut85@gmail.com

# --- Telegram alerts (optional) --------------------------------------------
# Plain HTTPS, so it works even where outbound SMTP is blocked.
#   1. @BotFather -> /newbot -> copy the token below.
#   2. Message your new bot once so it can reply to you.
#   3. @userinfobot -> copy your numeric id below.
# NOTE: these generic vars are used by the MAIN equity bot. Mayura has its OWN
# vars below (MAYURA_*) which ALWAYS win, so the two can never collide.
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_chat_id

# --- Mayura: its OWN bot + one Telegram TOPIC per face ----------------------
# 🔒 ISOLATION: Mayura uses MAYURA_BOT_TOKEN / MAYURA_CHAT_ID (NOT the generic
# TELEGRAM_* above) so Mayura's alerts can NEVER land in the main bot's group.
# These take priority whenever set; if blank, Mayura falls back to TELEGRAM_*.
# Create a group "Mayura" with Topics enabled (one topic per face), add YOUR
# Mayura bot as admin, then run:  python mayura.py telegram-setup
MAYURA_BOT_TOKEN=
MAYURA_CHAT_ID=
MAYURA_TOPIC_DANDAPANI=
MAYURA_TOPIC_SENTHIL=
MAYURA_TOPIC_SUBRAMANYA=
MAYURA_TOPIC_SWAMINATHA=
MAYURA_TOPIC_THANIKESA=
MAYURA_TOPIC_SOLAIMALAI=

# Weekly self-review (mayura.py analyze, cron Fridays 16:30 IST):
# set to 1 to let a SICK verdict (profit factor < 1 over >=10 closed trades)
# AUTO-PAUSE that face's NEW buys (exits always keep running).
# Resume any time:  python mayura.py unpause <face>
MAYURA_AUTO_PAUSE=
# Look-back window for the self-review, in days (default 90):
MAYURA_ANALYZE_DAYS=
