# SectorBot environment template — copy to a private .env on the DROPLET only.
# NEVER commit a real .env. NEVER put Kite/TOTP secrets in GitHub.
# (.env is already gitignored.)

# --- Kite (for REAL prices on the droplet) ---------------------------------
# Reuse your main bot's key + the token file it refreshes daily via TOTP.
KITE_API_KEY=your_kite_api_key
KITE_TOKEN_FILE=/home/globalbot/data/kite_token.json
# Alternatively, a raw token (expires daily) instead of the file:
# KITE_ACCESS_TOKEN=

# --- Email (optional) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=krishnut85@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=krishnut85@gmail.com

# --- Telegram alerts (optional) --------------------------------------------
# Plain HTTPS, so it works even where outbound SMTP is blocked.
#   1. @BotFather -> /newbot -> copy the token below.
#   2. Message your new bot once so it can reply to you.
#   3. @userinfobot -> copy your numeric id below.
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_chat_id
